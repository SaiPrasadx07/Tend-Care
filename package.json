{
  "name": "tend-care-mcp",
  "version": "0.1.0",
  "description": "Tend: a care-coordination add-on for Alexa+ built as a self-hosted MCP server (Streamable HTTP, MCP 2025-11-25) with an Amazon Bedrock-powered Alexa+ simulator.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "seed": "node scripts/seed.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:bedrock": "node scripts/bedrock-smoke.ts",
    "guardrail:create": "node scripts/create-guardrail.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1154.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
