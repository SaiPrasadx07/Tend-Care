# Copy to .env and adjust. Never commit .env.

# --- Server ---
# Loopback by default; demo endpoints are only enabled on loopback.
HOST=127.0.0.1
PORT=8787
# SQLite file (created automatically).
TEND_DB_PATH=./data/tend.db
# IANA timezone the household's dose times are in (default: system timezone).
TEND_TIMEZONE=America/Los_Angeles

# Caregivers who may call the MCP server: id|Display Name|caregiver-or-viewer|token (token >= 24 chars), comma-separated.
# If unset, three demo caregivers get random tokens generated at startup (never printed);
# the simulator uses short-lived session tokens instead. Set this to connect external MCP clients.
# Generate a token with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# TEND_CAREGIVERS=priya|Priya|caregiver|replace-with-random-token-1,arjun|Arjun|caregiver|replace-with-random-token-2,maria|Nurse Maria|viewer|replace-with-random-token-3

# HMAC secret for short-lived browser session tokens (>= 32 chars). Random per process if unset.
# TEND_SESSION_SECRET=

# Extra origins allowed to call /mcp and /api from a browser (comma-separated), e.g. a tunnel URL.
# TEND_ALLOWED_ORIGINS=

# Demo endpoints (/api/demo/session, /api/demo/reset). Default: on for loopback binds, off otherwise.
# TEND_DEMO_MODE=true

# --- Alexa+ simulator agent ---
# auto = use Amazon Bedrock when AWS credentials are found, otherwise the offline router
# bedrock = require Bedrock; offline = never call an LLM
TEND_AGENT_ENGINE=auto

# --- AWS (standard AWS credential chain: `aws configure`, AWS_PROFILE, or env keys) ---
AWS_REGION=us-east-1
# AWS_PROFILE=default
# Any Bedrock Converse model with tool use. Cross-region inference profile IDs start with us./eu./apac.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Optional Amazon Bedrock Guardrail (create with `npm run guardrail:create`)
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=1
